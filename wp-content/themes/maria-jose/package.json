{
  "name": "maria-jose-wordpress-theme",
  "private": true,
  "version": "1.0.0",
  "scripts": {
    "format:scss": "prettier --write \"assets/src/scss/**/*.scss\"",
    "format:check": "prettier --check \"assets/src/scss/**/*.scss\"",
    "predev": "npm run format:scss",
    "dev": "sass --watch assets/src/scss/main.scss:assets/dist/css/main.css --style=expanded --source-map",
    "prebuild": "npm run format:scss",
    "build": "sass assets/src/scss/main.scss assets/dist/css/main.css --style=compressed --no-source-map"
  },
  "devDependencies": {
    "prettier": "^3.6.2",
    "sass": "^1.101.0"
  }
}
